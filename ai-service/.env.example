# 复制成 .env 再填真实值：cp .env.example .env
# .env 已在 .gitignore 里，不要提交；也不要写进 application.yaml

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=mall_ai
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- hmall 服务地址（只读接口）----
HMALL_ITEM_URL=http://127.0.0.1:8081
HMALL_TRADE_URL=http://127.0.0.1:8085

# ---- Redis Stack（向量库，第 2 步起用到）----
# 注意端口是 9379，不是 6379——这台虚拟机的 Redis Stack 映射在 9379
REDIS_HOST=10.233.79.116
REDIS_PORT=9379
REDIS_PASSWORD=

# ---- 大模型 / Embedding（阿里云百炼 MaaS，OpenAI 兼容）----
# base-url 千万不能带 /v1：Spring AI 自己会拼 /v1/embeddings 和 /v1/chat/completions，
# 带上 /v1 会变成 /v1/v1/... ，启动时报 HTTP 404 且堆栈指向 RedisVectorStore，很容易误判
OPENAI_BASE_URL=https://your-maas-host/compatible-mode
OPENAI_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
